# Serena Web3 — Configurações de Ambiente
# Obtenha seu Client ID gratuito em: https://thirdweb.com/dashboard/settings/api-keys
VITE_THIRDWEB_CLIENT_ID=your_thirdweb_client_id_here

# Endereço do contrato Edition Drop (ERC-1155) deployado via Thirdweb na Base Sepolia ou Base Mainnet
VITE_EDITION_DROP_ADDRESS=0x0000000000000000000000000000000000000000

# Rede ativa: 'sepolia' ou 'base-sepolia' para testes, 'base' para produção
VITE_ACTIVE_CHAIN=sepolia
