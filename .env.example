# Serena Web3 — Configurações de Ambiente
# ============================================================================
# 1. VARIÁVEIS PÚBLICAS DE FRONTEND (Empacotadas pelo Vite)
# Obtenha seu Client ID gratuito em: https://thirdweb.com/dashboard/settings/api-keys
# ============================================================================
VITE_THIRDWEB_CLIENT_ID=your_thirdweb_client_id_here

# Endereço do contrato Edition Drop (ERC-1155) deployado via Thirdweb na Base Sepolia ou Base Mainnet
VITE_EDITION_DROP_ADDRESS=0x0000000000000000000000000000000000000000

# Rede ativa: 'sepolia' ou 'base-sepolia' para testes, 'base' para produção
VITE_ACTIVE_CHAIN=base-sepolia

# ============================================================================
# 2. CREDENCIAIS DE DEPLOY VIA TERMINAL (NUNCA prefixar com VITE_ nem comitar)
# Recomendado: Exportar apenas na sessão do terminal antes de rodar deploy:contract
# Consulte docs/DEPLOY_CONTRACT_GUIDE.md para o guia completo e troubleshooting.
# ============================================================================
# THIRDWEB_SECRET_KEY=your_thirdweb_secret_key_here
# ADMIN_PRIVATE_KEY=0x_your_64_hex_chars_private_key_here
